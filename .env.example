# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored so secrets never reach the repo.
#
# SERVER-SIDE ONLY. Do NOT prefix these with REACT_APP_ -- anything with that
# prefix is compiled into the public JavaScript bundle. deploy/deploy.sh
# uploads these to the server, where nginx injects the key into requests to
# Gemini (see deploy/nginx.conf).
# Generate a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-generative-language-api-key

# Optional. Defaults to gemini-3.1-pro-preview if unset.
GEMINI_MODEL=gemini-3.1-pro-preview
